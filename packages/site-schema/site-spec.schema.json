{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webverse.local/schemas/site-spec.schema.json",
  "title": "WebVerse SiteSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "theme", "pages"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "category"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "enum": ["portfolio", "restaurant", "other"] },
        "description": { "type": "string", "maxLength": 4000 }
      }
    },
    "theme": {
      "type": "object", "additionalProperties": false,
      "required": ["colors", "fonts"],
      "properties": {
        "colors": {
          "type": "object", "additionalProperties": false,
          "required": ["primary", "background", "surface", "text", "muted"],
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "surface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "muted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        "fonts": {
          "type": "object", "additionalProperties": false,
          "required": ["display", "body"],
          "properties": { "display": { "type": "string" }, "body": { "type": "string" } }
        },
        "radius": { "enum": ["small", "medium", "large"] }
      }
    },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "title", "sections"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^/" },
          "title": { "type": "string", "maxLength": 120 },
          "sections": {
            "type": "array", "maxItems": 40,
            "items": {
              "type": "object", "additionalProperties": true,
              "required": ["id", "type", "title"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "type": { "enum": ["3d-hero", "hero", "about", "project-grid", "menu-grid", "gallery", "booking-form", "contact", "faq", "testimonials", "footer"] },
                "title": { "type": "string", "maxLength": 180 },
                "scene": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "assets": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object" }
  }
}
